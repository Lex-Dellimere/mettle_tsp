// The window: a map of the cities on the left, controls and numbers on the right.
// Drawn with MythicUI. The solvers are in tsp.mettle.
import "mythic/mythic";
import "tsp.mettle";
import "std/math" as m;

// colors (0xAARRGGBB): ink on paper
const PAPER: uint32 = 0xFFF5F1E8;
const PAPER_EDGE: uint32 = 0xFFDCD4C4;
const GRID: uint32 = 0xFFE8E1D2;
const INK: uint32 = 0xFF2A2722;
const INK_FAINT: uint32 = 0x332A2722;
const TESTED: uint32 = 0xFFD0452B;      // edges under test
const TAKEN: uint32 = 0xFF2F8A4C;       // edges a step just put in
const BEST_BAND: uint32 = 0x66E8B448;   // wide band under the best tour found so far

export struct TspApp {
  t: Tsp;
  cities: float32;   // the cities slider
  algo: int32;
  speed: float32;    // 0..1, see steps_per_frame
  running: bool;
  last_us: int64;    // the frame time that already ran its steps
  pts: MythicVec2[402];
}

export fn tsp_app_init(app: TspApp*, seed: uint64) {
  tsp_seed(&app->t, seed);
  tsp_random_cities(&app->t, 40);
  app->cities = 40.0;
  app->algo = TSP_NEAREST;
  app->speed = 0.35;
  app->running = false;
}

// 1 step per frame at the left end of the slider, 20,000 at the right
export fn tsp_app_steps_per_frame(app: TspApp*) -> int64 {
  var v: float64 = m.exp((float64)app->speed * 4.30103 * 2.302585093);
  var k: int64 = (int64)(v + 0.5);
  if (k < 1) { k = 1; }
  return k;
}

fn active(app: TspApp*) -> bool {
  var ph: int32 = app->t.phase;
  return ph != TSP_IDLE && ph != TSP_DONE;
}

fn stop(app: TspApp*) {
  app->running = false;
  tsp_reset(&app->t);
}

// lengths are shown for a map 1000 units wide
fn units(v: float64) -> int64 { return (int64)(v * 1000.0 + 0.5); }

// ---------------------------------------------------------------- the map

struct Plot { x: float32; y: float32; s: float32; }

// the square the unit square is drawn into, centered in r
fn plot_of(r: MythicRect) -> Plot {
  var s: float32 = mythic_minf(r.w, r.h) - 48.0;
  if (s < 10.0) { s = 10.0; }
  var pl: Plot = { x: r.x + (r.w - s) * 0.5, y: r.y + (r.h - s) * 0.5, s: s };
  return pl;
}

fn city_pos(app: TspApp*, pl: Plot, c: int32) -> MythicVec2 {
  var v: MythicVec2 = { x: pl.x + (float32)app->t.x[c] * pl.s, y: pl.y + (float32)app->t.y[c] * pl.s };
  return v;
}

fn stroke_order(p: MythicPainter*, app: TspApp*, pl: Plot, order: int32*, k: int32, width: float32, color: uint32, closed: bool) {
  if (k < 2) { return; }
  for q: int32 in 0..k { app->pts[q] = city_pos(app, pl, order[q]); }
  mythic_paint_path_stroke(p, &app->pts[0], k, width, color, closed, 0.0);
}

fn stroke_edge(p: MythicPainter*, app: TspApp*, pl: Plot, a: int32, b: int32, width: float32, color: uint32) {
  if (a < 0 || b < 0) { return; }
  app->pts[0] = city_pos(app, pl, a);
  app->pts[1] = city_pos(app, pl, b);
  mythic_paint_path_stroke(p, &app->pts[0], 2, width, color, false, 0.0);
}

fn map_paint(ui: MythicUi*, p: MythicPainter*, r: MythicRect, data: rawptr) {
  var app: TspApp* = (TspApp*)data;
  var t: Tsp* = &app->t;
  mythic_paint_fill(p, r, mythic_radius(10.0), PAPER);
  mythic_paint_stroke(p, r, mythic_radius(10.0), 1.0, PAPER_EDGE);
  var pl: Plot = plot_of(r);
  var z: MythicCorners;
  for g: int32 in 0..11 {
    var off: float32 = pl.s * (float32)g / 10.0;
    var vl: MythicRect = { x: pl.x + off - 0.5, y: pl.y, w: 1.0, h: pl.s };
    var hl: MythicRect = { x: pl.x, y: pl.y + off - 0.5, w: pl.s, h: 1.0 };
    mythic_paint_fill_exact(p, vl, z, GRID);
    mythic_paint_fill_exact(p, hl, z, GRID);
  }
  var ph: int32 = t->phase;
  if (ph == TSP_BUILD) {
    stroke_order(p, app, pl, &t->tour[0], t->len, 2.0, INK, false);
    stroke_edge(p, app, pl, t->ea, t->eb, 3.0, TESTED);
  } else if (ph == TSP_IMPROVE) {
    stroke_order(p, app, pl, &t->tour[0], t->n, 2.0, INK, true);
    if (t->swapped) {
      stroke_edge(p, app, pl, t->ea, t->ec, 3.5, TAKEN);
      stroke_edge(p, app, pl, t->eb, t->ed, 3.5, TAKEN);
    } else {
      stroke_edge(p, app, pl, t->ea, t->eb, 3.0, TESTED);
      stroke_edge(p, app, pl, t->ec, t->ed, 3.0, TESTED);
    }
  } else if (ph == TSP_ANNEALING || ph == TSP_SEARCH) {
    stroke_order(p, app, pl, &t->best[0], t->n, 9.0, BEST_BAND, true);
    stroke_order(p, app, pl, &t->tour[0], t->n, 1.5, INK, true);
    if (ph == TSP_ANNEALING && t->swapped) {
      stroke_edge(p, app, pl, t->ea, t->ec, 3.0, TAKEN);
      stroke_edge(p, app, pl, t->eb, t->ed, 3.0, TAKEN);
    }
  } else if (ph == TSP_DONE) {
    stroke_order(p, app, pl, &t->best[0], t->n, 9.0, BEST_BAND, true);
    stroke_order(p, app, pl, &t->tour[0], t->n, 2.0, INK, true);
  }
  for c: int32 in 0..t->n {
    var v: MythicVec2 = city_pos(app, pl, c);
    if (c == 0) {
      mythic_paint_circle(p, v, 7.0, TESTED);
      mythic_paint_circle(p, v, 3.5, PAPER);
    } else {
      mythic_paint_circle(p, v, 4.0, INK);
    }
  }
  if (t->n == 0) {
    var th: MythicTheme* = mythic_theme(ui);
    var msg: string = "Click anywhere on the map to place a city.";
    var w: float32 = mythic_text_size(ui, msg, th->type.body).x;
    var at: MythicVec2 = { x: r.x + (r.w - w) * 0.5, y: r.y + r.h * 0.5 - 10.0 };
    mythic_paint_text(p, msg, th->type.body, at, th->colors.text_secondary);
  }
}

fn map_view(ui: MythicUi*, app: TspApp*) {
  var id: uint64 = mythic_id(ui, "map");
  var b: MythicBox;
  b.id = id;
  b.width = mythic_grow();
  b.height = mythic_grow();
  mythic_box_begin(ui, b);
  var r: MythicResp = mythic_interact(ui, id, MYTHIC_SENSE_CLICK);
  mythic_end(ui);
  mythic_node_paint(ui, &map_paint, (rawptr)app);
  if (!r.clicked && !r.right_clicked) { return; }
  var pl: Plot = plot_of(r.rect);
  var mx: float32 = ui->in.mouse.x;
  var my: float32 = ui->in.mouse.y;
  var nx: float64 = (float64)((mx - pl.x) / pl.s);
  var ny: float64 = (float64)((my - pl.y) / pl.s);
  if (r.clicked) {
    if (nx >= 0.0 && nx <= 1.0 && ny >= 0.0 && ny <= 1.0) {
      app->running = false;
      tsp_add_city(&app->t, nx, ny);
    }
  } else {
    var c: int32 = tsp_nearest_city(&app->t, nx, ny);
    if (c >= 0) {
      var v: MythicVec2 = city_pos(app, pl, c);
      var dx: float32 = v.x - mx;
      var dy: float32 = v.y - my;
      if (dx * dx + dy * dy <= 14.0 * 14.0) {
        app->running = false;
        tsp_remove_city(&app->t, c);
      }
    }
  }
}

// ---------------------------------------------------------------- the length chart

fn chart_paint(ui: MythicUi*, p: MythicPainter*, r: MythicRect, data: rawptr) {
  var app: TspApp* = (TspApp*)data;
  var t: Tsp* = &app->t;
  mythic_paint_fill(p, r, mythic_radius(6.0), PAPER);
  mythic_paint_stroke(p, r, mythic_radius(6.0), 1.0, PAPER_EDGE);
  var k: int32 = t->hist_n;
  if (k < 2) { return; }
  var lo: float32 = t->hist[0];
  var hi: float32 = t->hist[0];
  for q: int32 in 1..k {
    lo = mythic_minf(lo, t->hist[q]);
    hi = mythic_maxf(hi, t->hist[q]);
  }
  if (hi - lo < 0.000001) { hi = lo + 0.000001; }
  var pad: float32 = 10.0;
  var w: float32 = r.w - 2.0 * pad;
  var h: float32 = r.h - 2.0 * pad;
  var n: int32 = k;
  if (n > 400) { n = 400; }
  // k samples squeezed into at most 400 points
  for q: int32 in 0..n {
    var src: int32 = (int32)((int64)q * (int64)(k - 1) / (int64)mythic_maxi(n - 1, 1));
    var v: float32 = t->hist[src];
    app->pts[q].x = r.x + pad + w * (float32)q / (float32)mythic_maxi(n - 1, 1);
    app->pts[q].y = r.y + pad + h * (1.0 - (v - lo) / (hi - lo));
  }
  mythic_paint_path_stroke(p, &app->pts[0], n, 1.75, INK, false, 0.0);
}

fn chart(ui: MythicUi*, app: TspApp*) {
  var b: MythicBox;
  b.width = mythic_grow();
  b.height = mythic_fixed(84.0);
  mythic_box_begin(ui, b);
  mythic_end(ui);
  mythic_node_paint(ui, &chart_paint, (rawptr)app);
}

// ---------------------------------------------------------------- the side panel

fn caption(ui: MythicUi*, s: string) {
  mythic_label_ex(ui, s, { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY, wrap: true, width: mythic_grow() });
}

fn status_text(app: TspApp*) -> int32 {
  var t: Tsp* = &app->t;
  if (t->phase == TSP_IDLE) {
    if (t->n < 3) { return 0; }
    if (app->algo == TSP_EXHAUSTIVE && t->n > TSP_EXHAUSTIVE_MAX) { return 1; }
    return 2;
  }
  if (t->phase == TSP_BUILD) { return 3; }
  if (t->phase == TSP_IMPROVE) { return 4; }
  if (t->phase == TSP_ANNEALING) { return 5; }
  if (t->phase == TSP_SEARCH) { return 6; }
  if (t->algo == TSP_NEAREST) { return 7; }
  if (t->algo == TSP_ANNEAL) { return 8; }
  return 9;
}

fn status(ui: MythicUi*, app: TspApp*) {
  var s: int32 = status_text(app);
  if (s == 0) { caption(ui, "Place at least 3 cities."); }
  else if (s == 1) { caption(ui, "Exhaustive search allows up to 10 cities. 10 cities have 362,880 orders to try, and 15 cities have 87 billion."); }
  else if (s == 2) { caption(ui, "Press Solve to start, or Step to go one step at a time."); }
  else if (s == 3) { caption(ui, "The first tour starts at the red city and always goes to the nearest city it has not visited yet."); }
  else if (s == 4) { caption(ui, "2-opt tests each pair of edges, drawn in red, and reverses the stretch between them when that makes the tour shorter. The new edges show in green."); }
  else if (s == 5) { caption(ui, "Annealing reverses random stretches of the tour. It always keeps a shorter tour, and it keeps a longer one by chance, less often as the temperature falls. Yellow marks the shortest tour so far."); }
  else if (s == 6) { caption(ui, "Exhaustive search tries every order of the cities that starts at the red city. Yellow marks the shortest tour so far."); }
  else if (s == 7) { caption(ui, "2-opt has finished, because no single reversal shortens this tour. Such a tour is often a little longer than the shortest one."); }
  else if (s == 8) { caption(ui, "Annealing has finished. The map has the shortest tour the run found."); }
  else { caption(ui, "Exhaustive search has finished. It tried every order, so this is the shortest tour there is."); }
}

fn controls(ui: MythicUi*, app: TspApp*) {
  var t: Tsp* = &app->t;
  mythic_value_header(ui, "Cities", "{t->n}");
  var shown: int32 = mythic_clampi(t->n, 3, 200);
  app->cities = (float32)shown;
  if (mythic_slider_ex(ui, "##cities", &app->cities, { min: 3.0, max: 200.0, step: 1.0, width: mythic_grow() })) {
    app->running = false;
    tsp_random_cities(t, mythic_iround(app->cities));
  }
  mythic_row_begin(ui, { gap: 8 });
    if (mythic_button(ui, "New cities")) {
      app->running = false;
      tsp_random_cities(t, mythic_maxi(t->n, 3));
    }
    if (mythic_button_ex(ui, "Clear map", { variant: MYTHIC_BTN_GHOST })) {
      app->running = false;
      tsp_random_cities(t, 0);
    }
  mythic_end(ui);
  caption(ui, "Click the map to add a city. Right-click a city to remove it.");
  mythic_separator(ui);

  mythic_label_ex(ui, "Method", { role: MYTHIC_TYPE_LABEL, tone: MYTHIC_TONE_SECONDARY });
  var before: int32 = app->algo;
  mythic_radio(ui, "Nearest neighbour, then 2-opt", &app->algo, TSP_NEAREST);
  mythic_radio(ui, "Simulated annealing", &app->algo, TSP_ANNEAL);
  mythic_radio(ui, "Exhaustive search (up to 10 cities)", &app->algo, TSP_EXHAUSTIVE);
  if (app->algo != before) { stop(app); }

  var spf: int64 = tsp_app_steps_per_frame(app);
  if (spf == 1) { mythic_value_header(ui, "Speed", "1 step per frame"); }
  else { mythic_value_header(ui, "Speed", "{spf} steps per frame"); }
  mythic_slider_ex(ui, "##speed", &app->speed, { min: 0.0, max: 1.0, step: 0.01, width: mythic_grow() });

  var can_run: bool = t->n >= 3 && (app->algo != TSP_EXHAUSTIVE || t->n <= TSP_EXHAUSTIVE_MAX);
  mythic_row_begin(ui, { gap: 8 });
    var label: string = "Solve";
    if (app->running) { label = "Pause"; }
    else if (active(app)) { label = "Resume"; }
    mythic_disabled_begin(ui, !can_run);
      if (mythic_button_ex(ui, label, { variant: MYTHIC_BTN_PRIMARY })) {
        if (app->running) {
          app->running = false;
        } else {
          if (!active(app)) { tsp_start(t, app->algo); }
          app->running = active(app);
        }
      }
      if (mythic_button(ui, "Step")) {
        app->running = false;
        if (!active(app)) { tsp_start(t, app->algo); }
        else { tsp_step(t); }
      }
    mythic_disabled_end(ui);
    if (mythic_button_ex(ui, "Reset", { variant: MYTHIC_BTN_GHOST })) { stop(app); }
  mythic_end(ui);
}

fn fixed1(v: float64) -> int64 { return (int64)(v * 10.0 + 0.5); }

fn numbers(ui: MythicUi*, app: TspApp*) {
  var t: Tsp* = &app->t;
  var ph: int32 = t->phase;
  if (ph == TSP_IDLE) {
    mythic_value_header(ui, "Tour length", "no tour yet");
  } else if (ph == TSP_BUILD) {
    mythic_value_header(ui, "Tour length", "{t->len} of {t->n} cities joined");
  } else {
    mythic_value_header(ui, "Tour length", "{units(t->cost)}");
  }
  if (ph != TSP_IDLE && ph != TSP_BUILD) {
    if (t->algo != TSP_NEAREST) { mythic_value_header(ui, "Shortest so far", "{units(t->best_cost)}"); }
    mythic_value_header(ui, "First complete tour", "{units(t->start_cost)}");
  }
  if (ph != TSP_IDLE) {
    if (t->algo == TSP_NEAREST) {
      mythic_value_header(ui, "Steps", "{t->steps}");
      mythic_value_header(ui, "Reversals", "{t->swaps}");
    } else if (t->algo == TSP_ANNEAL) {
      mythic_value_header(ui, "Steps", "{t->steps} of {t->anneal_total}");
      var tt: int64 = fixed1(t->temp * 1000.0);
      mythic_value_header(ui, "Temperature", "{tt / 10}.{tt % 10}");
      mythic_value_header(ui, "Moves kept", "{t->accepted}");
    } else {
      mythic_value_header(ui, "Orders tried", "{t->steps} of {t->orders_total}");
    }
  }
}

fn side_panel(ui: MythicUi*, app: TspApp*) {
  mythic_scroll_begin(ui, "panel", { width: mythic_fixed(380), height: mythic_grow(), gap: 14 });
    mythic_label_ex(ui, "Traveling salesman", { role: MYTHIC_TYPE_HEADING });
    caption(ui, "Find the shortest round trip that visits every city once and comes back to the start.");
    controls(ui, app);
    status(ui, app);
    mythic_separator(ui);
    numbers(ui, app);
  mythic_end(ui);
}

// ---------------------------------------------------------------- the frame

export fn tsp_app_frame(ui: MythicUi*, ud: rawptr) {
  var app: TspApp* = (TspApp*)ud;
  // MythicUI may call this up to three times per frame to settle the layout; run the steps once
  var now: int64 = mythic_time_us(ui);
  if (app->running && now != app->last_us) {
    app->last_us = now;
    if (!tsp_run(&app->t, tsp_app_steps_per_frame(app))) { app->running = false; }
  }
  if (app->running) { mythic_request_frame_in(ui, 16); }
  mythic_row_begin(ui, { width: mythic_grow(), height: mythic_grow(), pad: mythic_pad(20), gap: 24 });
    mythic_column_begin(ui, { width: mythic_grow(), height: mythic_grow(), gap: 10 });
      map_view(ui, app);
      if (app->t.hist_n >= 2) {
        mythic_label_ex(ui, "Tour length over the run", { role: MYTHIC_TYPE_LABEL, tone: MYTHIC_TONE_SECONDARY });
        chart(ui, app);
      }
    mythic_end(ui);
    side_panel(ui, app);
  mythic_end(ui);
}
