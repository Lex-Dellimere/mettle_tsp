// Measures how long each method's tours are.
//   9 cities, 200 instances: percent above the shortest tour (found by exhaustive search)
//   100 cities, 50 instances: average length, map 1000 units wide
import "std/io";
import "../src/tsp.mettle";

fn finish(t: Tsp*, algo: int32) -> float64 {
  tsp_start(t, algo);
  while (tsp_step(t)) { }
  return tsp_cost_of(t, &t->tour[0], t->n);
}

fn nn_only(t: Tsp*) -> float64 {
  tsp_start(t, TSP_NEAREST);
  while (t->phase == TSP_BUILD) { tsp_step(t); }
  return tsp_cost_of(t, &t->tour[0], t->n);
}

fn pct(v: float64) -> int64 { return (int64)(v * 1000.0 + 0.5); }   // tenths of a percent

fn main() -> int32 {
  var t: Tsp* = new Tsp;
  tsp_seed(t, (uint64)2026);
  var nn: float64 = 0.0; var two: float64 = 0.0; var ann: float64 = 0.0;
  var nn_hit: int32 = 0; var two_hit: int32 = 0; var ann_hit: int32 = 0;
  var runs: int32 = 200;
  for r: int32 in 0..runs {
    tsp_random_cities(t, 9);
    var best: float64 = finish(t, TSP_EXHAUSTIVE);
    var a: float64 = nn_only(t);
    var b: float64 = finish(t, TSP_NEAREST);
    var c: float64 = finish(t, TSP_ANNEAL);
    nn = nn + (a / best - 1.0); two = two + (b / best - 1.0); ann = ann + (c / best - 1.0);
    if (a < best + 0.000001) { nn_hit = nn_hit + 1; }
    if (b < best + 0.000001) { two_hit = two_hit + 1; }
    if (c < best + 0.000001) { ann_hit = ann_hit + 1; }
  }
  var k: float64 = (float64)runs;
  println("9 cities, {runs} maps: tenths of a percent above shortest, and maps where the method found the shortest");
  println("nearest {pct(nn / k)} {nn_hit}");
  println("2opt {pct(two / k)} {two_hit}");
  println("anneal {pct(ann / k)} {ann_hit}");
  nn = 0.0; two = 0.0; ann = 0.0;
  var steps2: int64 = 0; var stepsa: int64 = 0;
  runs = 50;
  for r: int32 in 0..runs {
    tsp_random_cities(t, 100);
    nn = nn + nn_only(t);
    two = two + finish(t, TSP_NEAREST);
    steps2 = steps2 + t->steps;
    ann = ann + finish(t, TSP_ANNEAL);
    stepsa = stepsa + t->steps;
  }
  k = (float64)runs;
  println("100 cities, {runs} maps: average length, average steps");
  println("nearest {(int64)(nn / k * 1000.0)}");
  println("2opt {(int64)(two / k * 1000.0)} {steps2 / (int64)runs}");
  println("anneal {(int64)(ann / k * 1000.0)} {stepsa / (int64)runs}");
  return 0;
}
